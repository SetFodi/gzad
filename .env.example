# ─── Next.js app (set these in the Vercel project) ───────────────────────────

# Supabase project. The anon key is public by design and reaches the browser;
# RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Server-side only — never expose it to the browser and
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Conditional email verification. Apply the trusted-session migration and set
# up Supabase custom SMTP/code templates before enabling this during release.
# Existing sessions need verification after the database gate is applied.
AUTH_DEVICE_VERIFICATION=off
# Optional separate random secret, at least 32 characters. When unset, the
# server service-role key is used. Rotating it requires devices to verify again.
AUTH_DEVICE_SECRET=

# Shared secret between the app and the Realtime Server. Authenticates play-log
# and GPS callbacks, the billing trigger, and device key issuance.
CALLBACK_SECRET=

# Set a random server-only value in Vercel. Vercel sends it to scheduled routes.
# Also accepted by the billing calculation and email-only notification routes.
CRON_SECRET=

# Where the Realtime Server can be reached, and the secret for its HTTP API
# (this is the same value as the server's own API_SECRET).
REALTIME_SERVER_URL=http://167.71.50.3:3100
REALTIME_SERVER_SECRET=

# Once every controller has been re-provisioned with its own device key, set
# this to reject the shared secret in callback URLs. See migrations/README.md.
STRICT_DEVICE_KEYS=false

# Metered billing (migration 010). Leave unset to bill whole slot-hours. Set to
# a future Tbilisi midnight (20:00 UTC the day before) to bill 10-minute blocks
# from then on; it must be a whole hour. See migrations/README.md.
# BILLING_METERED_FROM=2026-11-30T20:00:00Z

# Daily rollup of old billing rows and pruning of raw play/GPS logs. Deletes
# data, so it only runs when set to "on".
# BILLING_RETENTION=on

# Low-balance emails. Server-only. Leave disabled until the delivery migration
# and the selected Resend or SMTP sender are ready. Supabase Auth email
# configuration is separate from these application billing notifications.
# BILLING_EMAIL_ENABLED=on
# Resend is the default provider. SMTP also needs its additive delivery migration.
BILLING_EMAIL_PROVIDER=resend
RESEND_API_KEY=
BILLING_EMAIL_FROM=Gzad <billing@example.com>
APP_URL=http://localhost:3000
# Temporary Gmail SMTP option: BILLING_EMAIL_PROVIDER=smtp, with the From address
# matching BILLING_SMTP_USER. Use a Google app password, never the account password.
# Only 465 (TLS) or 587 (required STARTTLS) are accepted. Credentials stay server-only.
BILLING_SMTP_HOST=smtp.gmail.com
BILLING_SMTP_PORT=465
BILLING_SMTP_USER=
BILLING_SMTP_PASS=


# ─── Realtime Server (realtime-server/.env on the VPS) ───────────────────────

# PORT=3100
# API_SECRET=            # must equal REALTIME_SERVER_SECRET above
# CALLBACK_SECRET=       # must equal CALLBACK_SECRET above
# GZAD_APP_URL=https://your-app.vercel.app
# WS_SECRET=             # controllers connect to ws://HOST:PORT?token=WS_SECRET
# ALLOWED_DEVICES=       # optional comma-separated card id allowlist
# NODE_ENV=production    # refuses to start on placeholder secrets

# Drives hourly billing from the VPS, because Vercel's free plan caps crons at
# one run per day. The endpoint is idempotent, so a repeated call is harmless.
# ENABLE_BILLING_TRIGGER=true
# BILLING_INTERVAL_MS=900000
